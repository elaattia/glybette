{
    "name": "glybette",
    "private": true,
    "scripts": {
        "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
        "build": "pnpm -r --filter \"./apps/*...\" run build",
        "prepare": "pnpm -r --filter \"./packages/*\" run build",
        "lint": "prettier --write .",
        "install:all": "pnpm -r install",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down"
    },
    "devDependencies": {
        "prettier": "^3.5.3"
    }
}
