# =========================
# Core runtime
# =========================
NODE_ENV=development

# Shared Atlas URI used by all DB-backed services.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# One internal secret shared between gateway and internal services.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-secret

# =========================
# Service ports
# =========================
PORT_API_GATEWAY=3000
PORT_USERS_SERVICE=3001
PORT_SCRAPING_SERVICE=3002
PORT_EMAIL_SERVICE=3003
PORT_PORTFOLIO_SERVICE=3004
PORT_AI_SERVICE=3005
PORT_CV_SERVICE=3006
PORT_PROJECTS_SERVICE=3007

# =========================
# API gateway (container DNS names)
# =========================
USERS_SERVICE_URL=http://users-service:3001
SCRAPING_SERVICE_URL=http://scraping-service:3002
EMAIL_SERVICE_URL=http://email-service:3003
PORTFOLIO_SERVICE_URL=http://portfolio-service:3004
AI_SERVICE_URL=http://ai-service:3005
CV_SERVICE_URL=http://cv-service:3006
PROJECTS_SERVICE_URL=http://projects-service:3007

# Explicit allowlist for host Vite origins used in dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://glybette.test:5173,http://rayen.glybette.test:5173
PROXY_TIMEOUT_MS=30000

# =========================
# Users service / Better Auth
# =========================
USERS_SERVICE_MONGODB_DB_NAME=users
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://glybette.test:5173,http://rayen.glybette.test:5173

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# =========================
# OTP + RabbitMQ
# =========================
EMAIL_DELIVERY_MODE=service
EMAIL_LOG_DIR=./logs
RABBITMQ_URL=amqp://rabbitmq:5672
OTP_SECRET=replace-with-a-random-secret-at-least-16-chars
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# =========================
# Email service
# =========================
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@glybette.dev
RESEND_API_KEY=

# =========================
# Portfolio service
# =========================
PORTFOLIO_SERVICE_MONGODB_DB_NAME=glybette_portfolios
PORTFOLIO_PUBLIC_ROOT_DOMAIN=glybette.test

# =========================
# Projects service
# =========================
PROJECTS_SERVICE_MONGODB_DB_NAME=glybette_projects
UPLOAD_PROVIDER=disk
PROJECTS_UPLOAD_DISK_DIR=/workspace/.data/projects-uploads
PROJECTS_UPLOAD_PUBLIC_BASE_URL=/api/projects/media
PROJECTS_UPLOAD_MAX_MB=5
PROJECTS_UPLOAD_S3_BUCKET=
PROJECTS_UPLOAD_S3_REGION=
PROJECTS_UPLOAD_S3_PREFIX=projects/covers
PROJECTS_UPLOAD_S3_ENDPOINT=
PROJECTS_UPLOAD_S3_FORCE_PATH_STYLE=false
PROJECTS_UPLOAD_S3_ACCESS_KEY_ID=
PROJECTS_UPLOAD_S3_SECRET_ACCESS_KEY=
PROJECTS_UPLOAD_S3_PUBLIC_BASE_URL=
USERS_SERVICE_URL=http://users-service:3001
INTEROP_SYNC_TIMEOUT_MS=7000

# =========================
# Client (Vite on host)
# =========================
VITE_API_BASE_URL=
VITE_PORTFOLIO_ROOT_DOMAIN=glybette.test
VITE_API_PROXY_TARGET=http://localhost:3000

# =========================
# Scraping service
# =========================
SCRAPING_MONGODB_NAME=glybette
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=7
SCHEDULE_INDEED=120
SCHEDULE_WTTJ=90
SCHEDULE_LINKEDIN=150
SCHEDULE_PFEBOOKS=60
ARCHIVE_AFTER_DAYS=60
SCRAPING_LOG_LEVEL=INFO

# =========================
# AI service (optional profile)
# =========================
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3:mini

# =========================
# CV service
# =========================
ALLOWED_ORIGINS=http://localhost:5173,http://glybette.test:5173,http://rayen.glybette.test:5173
