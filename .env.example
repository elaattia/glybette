# =========================
# Core runtime
# =========================
NODE_ENV=development
# Shared Atlas URI for all services (users, portfolio, scraping, cv).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# =========================
# Service ports
# =========================
PORT_API_GATEWAY=3000
PORT_USERS_SERVICE=3001
PORT_SCRAPING_SERVICE=3002
PORT_NOTIFICATIONS_SERVICE=3003
PORT_PORTFOLIO_SERVICE=3004
PORT_JOBS_SERVICE=3005
PORT_CV_SERVICE=3006
PORT_AI_SERVICE=3007
PORT_PROJECTS_SERVICE=3008


# =========================
# API gateway
# =========================
USERS_SERVICE_URL=http://localhost:3001
SCRAPING_SERVICE_URL=http://localhost:3002
NOTIFICATIONS_SERVICE_URL=http://localhost:3003
PORTFOLIO_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:3007
CV_SERVICE_URL=http://localhost:3006
JOBS_SERVICE_URL=http://localhost:3005
PROJECTS_SERVICE_URL=http://localhost:3008
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://glybette.test:5173,http://rayen.glybette.test:5173
PROXY_TIMEOUT_MS=30000
INTERNAL_SERVICE_SECRET=

# =========================
# Users service / Better Auth
# =========================
USERS_SERVICE_MONGODB_DB_NAME=users
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://glybette.test:5173,http://rayen.glybette.test:5173
INTERNAL_SERVICE_SECRET=

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INTERNAL_SERVICE_SECRET=

# =========================
# OTP + RabbitMQ
# =========================
# service = publish to notifications-service (mock writes apps/notifications-service/logs.txt)
# file = append to apps/users-service/logs/logs.txt (bypasses notifications-service)
EMAIL_DELIVERY_MODE=service
# Relative to apps/users-service when not absolute. Avoid /logs in Docker (not mounted).
EMAIL_LOG_DIR=logs
RABBITMQ_URL=amqp://localhost:5672
OTP_SECRET=replace-with-a-random-secret-at-least-16-chars
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
INTERNAL_SERVICE_SECRET=

# =========================
# Notifications service
# =========================
NOTIFICATIONS_SERVICE_MONGODB_DB_NAME=glybette_notifications
PROJECTS_SERVICE_URL=http://localhost:3008
INTEROP_SYNC_TIMEOUT_MS=7000
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@glybette.dev
RESEND_API_KEY=
INTERNAL_SERVICE_SECRET=

# =========================
# Portfolio service
# =========================
PORTFOLIO_SERVICE_MONGODB_DB_NAME=glybette_portfolios
PORTFOLIO_PUBLIC_ROOT_DOMAIN=glybette.com
INTERNAL_SERVICE_SECRET=

# =========================
# Projects service
# =========================
PROJECTS_SERVICE_MONGODB_DB_NAME=glybette_projects
UPLOAD_PROVIDER=disk
PROJECTS_UPLOAD_DISK_DIR=./uploads/projects
PROJECTS_UPLOAD_PUBLIC_BASE_URL=/api/projects/media
PROJECTS_UPLOAD_MAX_MB=5
PROJECTS_UPLOAD_S3_BUCKET=
PROJECTS_UPLOAD_S3_REGION=
PROJECTS_UPLOAD_S3_PREFIX=projects/covers
PROJECTS_UPLOAD_S3_ENDPOINT=
PROJECTS_UPLOAD_S3_FORCE_PATH_STYLE=false
PROJECTS_UPLOAD_S3_ACCESS_KEY_ID=
PROJECTS_UPLOAD_S3_SECRET_ACCESS_KEY=
PROJECTS_UPLOAD_S3_PUBLIC_BASE_URL=
USERS_SERVICE_URL=http://localhost:3001
INTEROP_SYNC_TIMEOUT_MS=7000
INTERNAL_SERVICE_SECRET=

# =========================
# Client (Vite)
# =========================
# Optional: if empty, frontend uses same-origin /api
VITE_API_BASE_URL=
VITE_PORTFOLIO_ROOT_DOMAIN=glybette.com
INTERNAL_SERVICE_SECRET=

# =========================
# Scraping service (Python)
# =========================
# Listen port: PORT_SCRAPING_SERVICE (see Service ports above).
# Uses the same MONGODB_URI as core unless you point to another DB.
SCRAPING_MONGODB_NAME=glybette
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=7
SCHEDULE_INDEED=120
SCHEDULE_WTTJ=90
SCHEDULE_LINKEDIN=150
SCHEDULE_PFEBOOKS=60
ARCHIVE_AFTER_DAYS=60
SCRAPING_LOG_LEVEL=INFO
INTERNAL_SERVICE_SECRET=
REDIS_URL=
# Redis configuration (déduplication cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Indeed anti-CAPTCHA: liste de proxies en JSON
# Format: PROXIES_LIST='["http://proxy1:8080", "http://proxy2:8080", "socks5://proxy3:1080"]'
# Laisse vide si pas de proxy
PROXIES_LIST=

INTERNAL_SERVICE_SECRET=

# =========================
# AI service 
# =========================
INTERNAL_SERVICE_SECRET=
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud



# =========================
# CV service
# =========================
INTERNAL_SERVICE_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
