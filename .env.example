# =========================
# Core runtime
# =========================
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/glybette

# =========================
# Service ports
# =========================
PORT_API_GATEWAY=3000
PORT_USERS_SERVICE=3001
PORT_SCRAPING_SERVICE=3002
PORT_EMAIL_SERVICE=3003

# =========================
# API gateway
# =========================
USERS_SERVICE_URL=http://localhost:3001
SCRAPING_SERVICE_URL=http://localhost:3002
EMAIL_SERVICE_URL=http://localhost:3003
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROXY_TIMEOUT_MS=30000

# =========================
# Users service / Better Auth
# =========================
USERS_SERVICE_MONGODB_DB_NAME=users
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# =========================
# OTP + RabbitMQ
# =========================
EMAIL_DELIVERY_MODE=service
EMAIL_LOG_DIR=./logs
RABBITMQ_URL=amqp://localhost:5672
OTP_SECRET=replace-with-a-random-secret-at-least-16-chars
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# =========================
# Email service
# =========================
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@glybette.dev
RESEND_API_KEY=

# =========================
# Client (Vite)
# =========================
# Optional: if empty, frontend uses same-origin /api
VITE_API_BASE_URL=

# =========================
# Scraping service (Python)
# =========================
# Listen port: PORT_SCRAPING_SERVICE (see Service ports above).
# Uses the same MONGODB_URI as core unless you point to another DB.
SCRAPING_MONGODB_NAME=glybette
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=7
SCHEDULE_INDEED=120
SCHEDULE_WTTJ=90
SCHEDULE_LINKEDIN=150
SCHEDULE_PFEBOOKS=60
ARCHIVE_AFTER_DAYS=60
SCRAPING_LOG_LEVEL=INFO
